    "model-context-protocol"
  ],
  "author": "Vu Duc Tuan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurovu146/claude-memory-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
